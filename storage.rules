rules_version = '2';

// Applicant uploads: uploads/{applicantId}/{file}
//   Applicants can add files to their own folder (PDF or image, 15 MB max) but can't read, replace or delete them.
//   Admins can read everything; only the owner can delete.
service firebase.storage {
  match /b/{bucket}/o {
    function verified() { return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email != null; }
    function myEmail()  { return request.auth.token.email.lower(); }
    function isAdmin()  {
      return verified() && (myEmail() == 'dkota@pvrs.org'
        || (firestore.exists(/databases/(default)/documents/staff/$(myEmail()))
            && firestore.get(/databases/(default)/documents/staff/$(myEmail())).data.role in ['admin', 'coordinator']));
    }
    function ownsPortal(id) {
      return verified() && firestore.exists(/databases/(default)/documents/portal/$(id))
        && firestore.get(/databases/(default)/documents/portal/$(id)).data.email == myEmail();
    }

    match /uploads/{appId}/{fileName} {
      allow read: if isAdmin();
      allow delete: if verified() && myEmail() == 'dkota@pvrs.org';
      allow create: if ownsPortal(appId)
        && request.resource.size <= 25 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf'
            || request.resource.contentType == 'application/msword'
            || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document');
    }

    // Records the owner uploads to an applicant's file. Admins can open them; nobody else can see them.
    match /records/{appId}/{fileName} {
      allow read: if isAdmin();
      allow create: if verified() && myEmail() == 'dkota@pvrs.org'
        && request.resource.size <= 25 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if verified() && myEmail() == 'dkota@pvrs.org';
    }

    // Confidential paperwork (medical, Social Security). Only orientationpaperwork@pvrs.org can open or delete it;
    // the applicant (into their own folder) and the owner can add files but can't read them back.
    match /confidential/{appId}/{fileName} {
      allow read, delete: if verified() && myEmail() == 'orientationpaperwork@pvrs.org';
      allow create: if (ownsPortal(appId) || (verified() && myEmail() == 'dkota@pvrs.org'))
        && request.resource.size <= 25 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf'
            || request.resource.contentType == 'application/msword'
            || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document');
    }

    // Files posted in a squad channel. Only that channel's members (and the owner) can add or open them.
    match /chat/{cid}/{fileName} {
      function inChannel() {
        return verified() && (myEmail() == 'dkota@pvrs.org'
          || (firestore.exists(/databases/(default)/documents/channels/$(cid))
              && myEmail() in firestore.get(/databases/(default)/documents/channels/$(cid)).data.members));
      }
      allow read: if inChannel();
      allow create: if inChannel() && request.resource.size <= 15 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if verified() && myEmail() == 'dkota@pvrs.org';
    }

    // Squad documents: same audience as the library entry (library/{docId}).
    match /library/{docId}/{fileName} {
      function entry() { return firestore.get(/databases/(default)/documents/library/$(docId)).data; }
      allow read: if verified() && (myEmail() == 'dkota@pvrs.org'
        || (firestore.exists(/databases/(default)/documents/staff/$(myEmail())) && firestore.get(/databases/(default)/documents/staff/$(myEmail())).data.role in entry().roles)
        || (firestore.exists(/databases/(default)/documents/portalEmails/$(myEmail())) && entry().newMembers == true));
      allow create: if verified() && myEmail() == 'dkota@pvrs.org' && request.resource.size <= 25 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if verified() && myEmail() == 'dkota@pvrs.org';
    }

    // Uploaded certificates and everything else: no access by default.
    match /{everythingElse=**} {
      allow read, write: if false;
    }
  }
}

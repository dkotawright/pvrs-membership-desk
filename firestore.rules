rules_version = '2';

// PVRS Membership Desk — who can see what
//   Owner (dkota@pvrs.org): reads and edits everything
//   Staff with role "admin": read everything; may only fill in the interview questionnaire
//   Staff with role "member": read application + interview; may only fill in the interview questionnaire
//   Applicants: their own portal page, their own uploads, open interview times
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()  { return request.auth != null; }
    function verified()  { return signedIn() && request.auth.token.email_verified == true && request.auth.token.email != null; }
    function myEmail()   { return request.auth.token.email.lower(); }
    function isOwner()   { return verified() && myEmail() == 'dkota@pvrs.org'; }
    function staffPath() { return /databases/$(database)/documents/staff/$(myEmail()); }
    function isStaff()   { return isOwner() || (verified() && exists(staffPath())); }
    function isAdmin()   { return isOwner() || (verified() && exists(staffPath()) && get(staffPath()).data.role == 'admin'); }
    function portalOf(id)      { return get(/databases/$(database)/documents/portal/$(id)); }
    function ownsPortal(id)    { return verified() && exists(/databases/$(database)/documents/portal/$(id)) && portalOf(id).data.email == myEmail(); }
    // Invited applicants: the owner's desk keeps portalEmails/{email} in sync with the portal docs.
    function isInvitedApplicant() { return verified() && exists(/databases/$(database)/documents/portalEmails/$(myEmail())); }
    function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function nowMs()     { return request.time.toMillis(); }
    function DAY()       { return 86400000; }
    // What non-owner staff may change on an applicant: interview answers (iv), interview completed date/initials,
    // the Interview page sign-off, and the updated-by stamp.
    function subChangedOnly(field, keys) {
      return request.resource.data.get(field, {}).diff(resource.data.get(field, {})).affectedKeys().hasOnly(keys);
    }
    function interviewOnly() {
      return onlyChanged(['iv', 'sched', 'signoff', 'updatedAt', 'updatedBy'])
        && subChangedOnly('sched', ['completed', 'completedInit'])
        && subChangedOnly('signoff', ['iv'])
        && request.resource.data.updatedBy == myEmail();
    }

    // Requests to join the team. Anyone signed in with a verified email may file one request for their own address;
    // only the owner can read them all and approve or deny. The requester can see and withdraw their own.
    match /accessRequests/{email} {
      allow read: if isOwner() || (verified() && email == myEmail());
      allow create: if verified() && email == myEmail()
        && request.resource.data.keys().hasOnly(['email', 'name', 'note', 'requestedAt', 'status'])
        && request.resource.data.email == myEmail()
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt is int
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 300;
      allow update: if isOwner();
      allow delete: if isOwner() || (verified() && email == myEmail() && resource.data.status != 'denied');
    }

    // Which email addresses have an applicant portal (lets the rules recognise invited applicants).
    match /portalEmails/{email} {
      allow read: if isOwner() || (verified() && email == myEmail());
      allow write: if isOwner();
    }

    // Team roster. Everyone can read their own entry (so the app knows their role).
    match /staff/{email} {
      allow read: if isAdmin() || (verified() && email == myEmail());
      allow write: if isOwner() && email != 'dkota@pvrs.org';
    }

    // Application + interview (shared with members)
    match /applicants/{id} {
      allow read: if isStaff();
      allow create, delete: if isOwner();
      allow update: if isOwner() || (isStaff() && interviewOnly());

      // Screening, board, onboarding, notes (admins only)
      match /private/{doc} {
        allow read: if isAdmin();
        allow write: if isOwner();
      }

      // Records the owner uploads to an applicant's file (MVR, background check, interview intake…). Staff-only:
      // admins can open and print them; members and applicants never see them.
      match /records/{recordId} {
        allow read: if isAdmin();
        allow create: if isOwner()
          && request.resource.data.keys().hasOnly(['name','label','path','size','contentType','uploadedAt','uploadedBy'])
          && request.resource.data.path.matches('records/' + id + '/.*')
          && request.resource.data.uploadedBy == myEmail()
          && request.resource.data.size is int && request.resource.data.size <= 25 * 1024 * 1024;
        allow update, delete: if isOwner();
      }

      // Change history: append-only. Any staff member's edits are logged under their own email; only admins read it.
      match /history/{entryId} {
        allow read: if isAdmin();
        allow create: if isStaff()
          && request.resource.data.keys().hasOnly(['at','by','changes'])
          && request.resource.data.by == myEmail()
          && request.resource.data.at is int
          && request.resource.data.at > nowMs() - 300000 && request.resource.data.at < nowMs() + 300000
          && request.resource.data.changes is list && request.resource.data.changes.size() <= 200;
        allow delete: if isOwner();
      }
    }
    // Lets the Desk load every private record in one query
    match /{path=**}/private/{doc} {
      allow read: if isAdmin();
    }
    // Lets admins load every conversation in one query (the Messages inbox)
    match /{path=**}/messages/{messageId} {
      allow read: if isAdmin();
    }
    // Lets admins see every applicant upload in one query (the Overview activity feed)
    match /{path=**}/files/{fileId} {
      allow read: if isAdmin();
    }

    // What the applicant sees. Written by admins; the applicant may only book or cancel an interview.
    match /portal/{id} {
      allow read: if isAdmin() || (verified() && resource.data.email == myEmail());
      allow create, delete: if isOwner();
      allow update: if isOwner() || (
        verified() && resource.data.email == myEmail()
        && onlyChanged(['interview'])
        && (
          // booking (only while you've opened booking for them): the slot must now be held by this applicant
          (request.resource.data.interview != null
            && resource.data.get('bookingOpen', false) == true
            && getAfter(/databases/$(database)/documents/slots/$(request.resource.data.interview.slotId)).data.bookedBy == id
            && request.resource.data.interview.start == getAfter(/databases/$(database)/documents/slots/$(request.resource.data.interview.slotId)).data.start)
          ||
          // cancelling: the old slot must be released
          (request.resource.data.interview == null && resource.data.interview != null
            && getAfter(/databases/$(database)/documents/slots/$(resource.data.interview.slotId)).data.bookedBy == null)
        )
      );

      // Messages between the applicant and the squad. The applicant writes as themselves; only the owner replies.
      // Admins can read every conversation; members can't. Applicants may only mark the squad's replies as seen.
      match /messages/{messageId} {
        allow read: if isAdmin() || ownsPortal(id);
        allow create: if request.resource.data.keys().hasOnly(['text', 'from', 'by', 'name', 'at'])
          && request.resource.data.by == myEmail()
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 100
          && request.resource.data.at is int && request.resource.data.at > nowMs() - 300000 && request.resource.data.at < nowMs() + 300000
          && ((request.resource.data.from == 'applicant' && ownsPortal(id))
              || (request.resource.data.from == 'staff' && isOwner()));
        allow update: if isOwner()
          || (ownsPortal(id) && resource.data.from == 'staff' && onlyChanged(['seenAt']) && request.resource.data.seenAt is int);
        allow delete: if isOwner();
      }

      // Files the applicant uploaded
      match /files/{fileId} {
        allow read: if isAdmin() || ownsPortal(id);
        allow create: if ownsPortal(id)
          && request.resource.data.keys().hasOnly(['docKey','label','name','path','size','contentType','uploadedAt','uploadedBy'])
          && request.resource.data.uploadedBy == myEmail()
          && request.resource.data.path.matches('uploads/' + id + '/.*')
          && request.resource.data.size is int && request.resource.data.size <= 15 * 1024 * 1024;
        allow update, delete: if isOwner();
      }
    }

    // Interview times you post. Applicants can only claim or release a slot for themselves, 24h+ ahead.
    match /slots/{slotId} {
      allow read: if isStaff() || isInvitedApplicant();
      allow create, delete: if isOwner();
      allow update: if isOwner() || (
        verified() && onlyChanged(['bookedBy']) && resource.data.start > nowMs() + DAY()
        && (
          (resource.data.bookedBy == null && request.resource.data.bookedBy is string
            && ownsPortal(request.resource.data.bookedBy)
            && portalOf(request.resource.data.bookedBy).data.get('bookingOpen', false) == true
            && getAfter(/databases/$(database)/documents/portal/$(request.resource.data.bookedBy)).data.interview.slotId == slotId)
          ||
          (resource.data.bookedBy != null && request.resource.data.bookedBy == null
            && ownsPortal(resource.data.bookedBy)
            && (getAfter(/databases/$(database)/documents/portal/$(resource.data.bookedBy)).data.interview == null
                || getAfter(/databases/$(database)/documents/portal/$(resource.data.bookedBy)).data.interview.slotId != slotId))
        )
      );
    }

    // Email signature, contact address (admins only)
    match /settings/{doc} {
      allow read: if isAdmin();
      allow write: if isOwner();
    }
  }
}

rules_version = '2';

// PVRS Membership Desk — who can see what
//   Owner (dkota@pvrs.org): reads and edits everything
//   Staff with role "admin": read everything; may only fill in the interview questionnaire
//   Staff with role "interviewer": read application + interview of the applicants the owner assigned them to
//     (applicants/{id}.interviewers); may only fill in those interview questionnaires
//   Staff with role "member": no applicant files; Messages only (channels and conversations they're added to)
//   Applicants: their own portal page, their own uploads, open interview times
//   Paperwork account (orientationpaperwork@pvrs.org): the only one who can open confidential (medical / Social Security) files
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()  { return request.auth != null; }
    function verified()  { return signedIn() && request.auth.token.email_verified == true && request.auth.token.email != null; }
    function myEmail()   { return request.auth.token.email.lower(); }
    function isOwner()   { return verified() && myEmail() == 'dkota@pvrs.org'; }
    function isPaperwork() { return verified() && myEmail() == 'orientationpaperwork@pvrs.org'; }
    function staffPath() { return /databases/$(database)/documents/staff/$(myEmail()); }
    function isStaff()   { return isOwner() || (verified() && exists(staffPath())); }
    function isAdmin()   { return isOwner() || (verified() && exists(staffPath()) && get(staffPath()).data.role == 'admin'); }
    // Interviewers the owner assigned to this applicant (applicants/{id}.interviewers, a list of emails).
    function assignedTo(data)  { return verified() && exists(staffPath()) && myEmail() in data.get('interviewers', []); }
    function canHost()         { return isAdmin() || (verified() && exists(staffPath()) && get(staffPath()).data.role == 'interviewer'); }
    function portalOf(id)      { return get(/databases/$(database)/documents/portal/$(id)); }
    // Team messaging: squad channels (channels/{id}) and the squad members the owner adds to an applicant's conversation (convos/{appId}).
    function inChannel(cid)    { return verified() && exists(/databases/$(database)/documents/channels/$(cid)) && myEmail() in get(/databases/$(database)/documents/channels/$(cid)).data.members; }
    function inConvo(id)       { return verified() && exists(/databases/$(database)/documents/convos/$(id)) && myEmail() in get(/databases/$(database)/documents/convos/$(id)).data.members; }
    function ownsPortal(id)    { return verified() && exists(/databases/$(database)/documents/portal/$(id)) && portalOf(id).data.email == myEmail(); }
    // Invited applicants: the owner's desk keeps portalEmails/{email} in sync with the portal docs.
    function isInvitedApplicant() { return verified() && exists(/databases/$(database)/documents/portalEmails/$(myEmail())); }
    function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function nowMs()     { return request.time.toMillis(); }
    function DAY()       { return 86400000; }
    // What non-owner staff may change on an applicant: interview answers (iv), interview completed date/initials,
    // the Interview page sign-off, and the updated-by stamp.
    function subChangedOnly(field, keys) {
      return request.resource.data.get(field, {}).diff(resource.data.get(field, {})).affectedKeys().hasOnly(keys);
    }
    function interviewOnly() {
      return onlyChanged(['iv', 'sched', 'signoff', 'updatedAt', 'updatedBy'])
        && subChangedOnly('sched', ['completed', 'completedInit'])
        && subChangedOnly('signoff', ['iv'])
        && request.resource.data.updatedBy == myEmail();
    }

    // Requests to join the team. Anyone signed in with a verified email may file one request for their own address;
    // only the owner can read them all and approve or deny. The requester can see and withdraw their own.
    match /accessRequests/{email} {
      allow read: if isOwner() || (verified() && email == myEmail());
      allow create: if verified() && email == myEmail()
        && request.resource.data.keys().hasOnly(['email', 'name', 'note', 'requestedAt', 'status'])
        && request.resource.data.email == myEmail()
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt is int
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 300;
      allow update: if isOwner();
      allow delete: if isOwner() || (verified() && email == myEmail() && resource.data.status != 'denied');
    }

    // Online applications from the public form (no sign-in needed). Strict shape. A driver's license number and
    // 3–4 references are required (the squad runs a driving-record check).
    // Only the owner can read them; the owner's desk turns each one into an applicant record.
    function validSubmission() {
      let d = request.resource.data;
      let p = d.person;
      return d.keys().hasOnly(['v', 'status', 'submittedAt', 'hp', 'person', 'education', 'experience', 'employment', 'background', 'references', 'signature', 'heard'])
        && d.v == 1 && d.status == 'new' && d.hp == ''
        && d.submittedAt is int && d.submittedAt > nowMs() - 600000 && d.submittedAt < nowMs() + 600000
        && p is map && p.keys().hasOnly(['first', 'last', 'email', 'phone', 'dob', 'birthplace', 'permAddr', 'localAddr', 'dlState', 'dlNumber', 'type'])
        && p.dlNumber is string && p.dlNumber.size() > 0 && p.dlNumber.size() <= 30
        && p.dlState is string && p.dlState != 'none'
        && p.first is string && p.first.size() > 0 && p.first.size() <= 200
        && p.last is string && p.last.size() > 0 && p.last.size() <= 200
        && p.email is string && p.email.size() <= 200 && p.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && p.phone is string && p.phone.size() <= 40
        && p.type in ['Regular', 'Associate', 'Auxiliary', 'Non-Operational', 'Driver Only', 'Non-Resident']
        && d.education is map && d.experience is map && d.employment is map && d.background is map
        && d.references is list && d.references.size() >= 3 && d.references.size() <= 4
        && d.signature is map && d.signature.keys().hasOnly(['confirmed', 'name'])
        && d.signature.confirmed == true && d.signature.name is string && d.signature.name.size() >= 3 && d.signature.name.size() <= 200
        && (!('heard' in d) || (d.heard is map && d.heard.keys().hasOnly(['source', 'detail'])
            && d.heard.source is string && d.heard.source.size() <= 60 && d.heard.get('detail', '') is string && d.heard.get('detail', '').size() <= 200));
    }
    match /submissions/{submissionId} {
      allow create: if validSubmission();
      allow read, update, delete: if isOwner();
    }

    // Confidential paperwork (medical, Social Security). The file goes to Storage confidential/{appId}/…, its details
    // here, and only the paperwork account can read either. Applicants add their own; the owner can add but not open.
    // A placeholder with no name or link ("Private document") goes in the applicant's file list so the squad can
    // see something arrived. A server function emails the paperwork account when a new one comes in.
    function confidentialStub() {
      let d = request.resource.data;
      return d.keys().hasOnly(['docKey','label','name','path','size','contentType','uploadedAt','uploadedBy','confidential'])
        && d.confidential == true && d.path == '' && d.name == 'Private document';
    }
    match /vault/{fileId} {
      allow read, delete: if isPaperwork();
      allow update: if isPaperwork() && onlyChanged(['filedAt']);
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['appId','appName','label','name','path','size','contentType','uploadedAt','uploadedBy','from'])
        && request.resource.data.appId is string
        && request.resource.data.path.matches('confidential/' + request.resource.data.appId + '/.*')
        && request.resource.data.uploadedBy == myEmail()
        && request.resource.data.uploadedAt is int && request.resource.data.uploadedAt > nowMs() - 300000 && request.resource.data.uploadedAt < nowMs() + 300000
        && request.resource.data.size is int && request.resource.data.size <= 25 * 1024 * 1024
        && request.resource.data.label is string && request.resource.data.label.size() <= 200
        && request.resource.data.name is string && request.resource.data.name.size() <= 300
        && request.resource.data.appName is string && request.resource.data.appName.size() <= 200
        && ((request.resource.data.from == 'applicant' && ownsPortal(request.resource.data.appId))
            || (request.resource.data.from == 'staff' && isOwner()));
    }

    // Reference forms. The owner makes a private link for each reference (refLinks/{token}, an unguessable code);
    // anyone holding the exact code can open it (no listing) and send ONE response (refResponses/{token}) before it
    // expires. Only the owner reads responses; the desk files them in the applicant's private record.
    match /refLinks/{token} {
      allow get: if true;
      allow list, create, delete: if isOwner();
      allow update: if isOwner() || (
        onlyChanged(['submittedAt']) && resource.data.get('submittedAt', null) == null
        && request.resource.data.submittedAt is int
        && existsAfter(/databases/$(database)/documents/refResponses/$(token)));
    }
    function validRefResponse(token) {
      let link = get(/databases/$(database)/documents/refLinks/$(token)).data;
      let d = request.resource.data;
      let a = d.answers;
      let r = a.ratings;
      return link.expiresAt > nowMs() && link.get('submittedAt', null) == null
        && d.keys().hasOnly(['v', 'answers', 'submittedAt', 'hp']) && d.v == 1 && d.hp == ''
        && d.submittedAt is int && d.submittedAt > nowMs() - 600000 && d.submittedAt < nowMs() + 600000
        && a is map && a.keys().hasOnly(['known', 'skills', 'getAlong', 'criticism', 'ratings', 'trustworthy', 'reservations', 'other', 'others', 'signName', 'signDate'])
        && a.known is string && a.known.size() > 0 && a.known.size() <= 4000 && a.skills is string && a.skills.size() > 0 && a.skills.size() <= 4000
        && a.getAlong is string && a.getAlong.size() > 0 && a.getAlong.size() <= 4000 && a.criticism is string && a.criticism.size() > 0 && a.criticism.size() <= 4000
        && a.reservations is string && a.reservations.size() > 0 && a.reservations.size() <= 4000 && a.other is string && a.other.size() > 0 && a.other.size() <= 4000
        && a.others is string && a.others.size() >= 0 && a.others.size() <= 4000
        && a.signName is string && a.signName.size() > 1 && a.signName.size() <= 200 && a.signDate is string && a.signDate.size() <= 20
        && a.trustworthy in ['yes', 'no']
        && r is map && r.keys().hasOnly(['reliability', 'flexibility', 'timeManagement', 'communication', 'responsibility', 'appearance', 'disposition']) && r.keys().hasAll(['reliability', 'flexibility', 'timeManagement', 'communication', 'responsibility', 'appearance', 'disposition'])
        && r.reliability is int && r.reliability >= 1 && r.reliability <= 5 && r.flexibility is int && r.flexibility >= 1 && r.flexibility <= 5 && r.timeManagement is int && r.timeManagement >= 1 && r.timeManagement <= 5 && r.communication is int && r.communication >= 1 && r.communication <= 5 && r.responsibility is int && r.responsibility >= 1 && r.responsibility <= 5 && r.appearance is int && r.appearance >= 1 && r.appearance <= 5 && r.disposition is int && r.disposition >= 1 && r.disposition <= 5;
    }
    match /refResponses/{token} {
      allow create: if exists(/databases/$(database)/documents/refLinks/$(token)) && validRefResponse(token);
      allow read, update, delete: if isOwner();
    }

    // Which email addresses have an applicant portal (lets the rules recognise invited applicants).
    match /portalEmails/{email} {
      allow read: if isOwner() || (verified() && email == myEmail());
      allow write: if isOwner();
    }

    // Team roster. Everyone can read their own entry (so the app knows their role).
    match /staff/{email} {
      allow read: if isAdmin() || (verified() && email == myEmail());
      allow write: if isOwner() && email != 'dkota@pvrs.org';
    }

    // Application + interview: admins see all; interviewers only the applicants assigned to them (works for
    // "where interviewers array-contains me" queries); members none.
    match /applicants/{id} {
      allow read: if isAdmin() || assignedTo(resource.data);
      allow create, delete: if isOwner();
      allow update: if isOwner() || ((isAdmin() || assignedTo(resource.data)) && interviewOnly());

      // Screening, board, onboarding, notes (admins only)
      match /private/{doc} {
        allow read: if isAdmin();
        allow write: if isOwner();
      }

      // Records the owner uploads to an applicant's file (MVR, background check, interview intake…). Staff-only:
      // admins can open and print them; members and applicants never see them.
      match /records/{recordId} {
        allow read: if isAdmin();
        allow create: if isOwner()
          && request.resource.data.uploadedBy == myEmail()
          && request.resource.data.size is int && request.resource.data.size <= 25 * 1024 * 1024
          && ((request.resource.data.keys().hasOnly(['name','label','path','size','contentType','uploadedAt','uploadedBy'])
               && request.resource.data.path.matches('records/.*'))   // a combined file keeps the other file's folder
              || confidentialStub());
        allow update, delete: if isOwner();
      }

      // Change history: append-only. Any staff member's edits are logged under their own email; only admins read it.
      match /history/{entryId} {
        allow read: if isAdmin();
        allow create: if (isAdmin() || assignedTo(get(/databases/$(database)/documents/applicants/$(id)).data))
          && request.resource.data.keys().hasOnly(['at','by','changes'])
          && request.resource.data.by == myEmail()
          && request.resource.data.at is int
          && request.resource.data.at > nowMs() - 300000 && request.resource.data.at < nowMs() + 300000
          && request.resource.data.changes is list && request.resource.data.changes.size() <= 200;
        allow delete: if isOwner();
      }
    }
    // Lets the Desk load every private record in one query
    match /{path=**}/private/{doc} {
      allow read: if isAdmin();
    }
    // Lets the owner load every applicant conversation in one query (Messages). Others see only conversations they're added to.
    match /{path=**}/messages/{messageId} {
      allow read: if isOwner();
    }
    match /{path=**}/checkins/{n} {
      allow read: if isAdmin();
    }
    // Lets the owner's desk pick up new references from every applicant in one query
    match /{path=**}/refUpdates/{updateId} {
      allow read: if isOwner();
    }
    // Lets admins see every applicant upload in one query (the Overview activity feed)
    match /{path=**}/files/{fileId} {
      allow read: if isAdmin();
    }

    // What the applicant sees. Written by admins; the applicant may only book or cancel an interview.
    match /portal/{id} {
      allow read: if isAdmin() || (verified() && resource.data.email == myEmail());
      allow create, delete: if isOwner();
      allow update: if isOwner() || (
        // orientation booking: only once the owner's desk has opened orientation (Sterling complete and clear)
        verified() && resource.data.email == myEmail()
        && onlyChanged(['orient'])
        && resource.data.get('orientation', null) != null
        && (
          (request.resource.data.orient != null
            && getAfter(/databases/$(database)/documents/orientSlots/$(request.resource.data.orient.slotId)).data.bookedBy == id
            && request.resource.data.orient.start == getAfter(/databases/$(database)/documents/orientSlots/$(request.resource.data.orient.slotId)).data.start)
          ||
          (request.resource.data.orient == null && resource.data.orient != null
            && getAfter(/databases/$(database)/documents/orientSlots/$(resource.data.orient.slotId)).data.bookedBy == null)
        )
      ) || (
        verified() && resource.data.email == myEmail()
        && onlyChanged(['interview'])
        && (
          // booking (only while you've opened booking for them): the slot must now be held by this applicant
          (request.resource.data.interview != null
            && resource.data.get('bookingOpen', false) == true
            && getAfter(/databases/$(database)/documents/slots/$(request.resource.data.interview.slotId)).data.bookedBy == id
            && request.resource.data.interview.start == getAfter(/databases/$(database)/documents/slots/$(request.resource.data.interview.slotId)).data.start)
          ||
          // cancelling: the old slot must be released
          (request.resource.data.interview == null && resource.data.interview != null
            && getAfter(/databases/$(database)/documents/slots/$(resource.data.interview.slotId)).data.bookedBy == null)
        )
      );

      // Messages between the applicant and the squad. The applicant writes as themselves; the owner and the squad members
      // the owner added to this conversation (convos/{id}) read and reply. Applicants may only mark the squad's replies as seen.
      match /messages/{messageId} {
        allow read: if isOwner() || inConvo(id) || ownsPortal(id);
        allow create: if request.resource.data.keys().hasOnly(['text', 'from', 'by', 'name', 'at'])
          && request.resource.data.by == myEmail()
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 100
          && request.resource.data.at is int && request.resource.data.at > nowMs() - 300000 && request.resource.data.at < nowMs() + 300000
          && ((request.resource.data.from == 'applicant' && ownsPortal(id))
              || (request.resource.data.from == 'staff' && (isOwner() || inConvo(id))));
        allow update: if isOwner()
          || (ownsPortal(id) && resource.data.from == 'staff' && onlyChanged(['seenAt']) && request.resource.data.seenAt is int);
        allow delete: if isOwner();
      }

      // A different reference, sent by the applicant when the owner asks for one (portal.refReplace lists which).
      // The owner's desk copies it into the private references and marks it applied.
      // 30- and 90-day check-ins from new members. One answer each; the applicant can't change it afterwards.
      match /checkins/{n} {
        allow read: if isAdmin() || ownsPortal(id);
        allow create: if ownsPortal(id) && n in ['30', '90']
          && request.resource.data.keys().hasOnly(['rating', 'going', 'help', 'at'])
          && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && request.resource.data.going is string && request.resource.data.going.size() <= 2000
          && request.resource.data.help is string && request.resource.data.help.size() <= 2000
          && request.resource.data.at is int;
        allow delete: if isOwner();
      }
      match /refUpdates/{updateId} {
        allow read: if isOwner() || ownsPortal(id);
        allow create: if ownsPortal(id)
          && request.resource.data.keys().hasOnly(['slot', 'name', 'relationship', 'email', 'phone', 'address', 'at', 'by'])
          && request.resource.data.slot is int && request.resource.data.slot in portalOf(id).data.get('refReplace', [])
          && request.resource.data.by == myEmail()
          && request.resource.data.at is int && request.resource.data.at > nowMs() - 300000 && request.resource.data.at < nowMs() + 300000
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
          && request.resource.data.relationship is string && request.resource.data.relationship.size() <= 200
          && request.resource.data.email is string && request.resource.data.email.size() <= 200 && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
          && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
          && request.resource.data.address is string && request.resource.data.address.size() <= 300;
        allow update: if isOwner() && onlyChanged(['appliedAt']);
        allow delete: if isOwner();
      }

      // Files the applicant uploaded
      match /files/{fileId} {
        allow read: if isAdmin() || ownsPortal(id);
        allow create: if ownsPortal(id)
          && request.resource.data.uploadedBy == myEmail()
          && request.resource.data.size is int && request.resource.data.size <= 15 * 1024 * 1024
          && ((request.resource.data.keys().hasOnly(['docKey','label','name','path','size','contentType','uploadedAt','uploadedBy'])
               && request.resource.data.path.matches('uploads/' + id + '/.*'))
              || confidentialStub());
        allow update, delete: if isOwner();
      }
    }

    // Interview times you post. Applicants can only claim or release a slot for themselves, 24h+ ahead.
    match /slots/{slotId} {
      allow read: if isStaff() || isInvitedApplicant();
      // The owner manages every time. Admins and interviewers offer their own (host = themselves) and can delete their own
      // while nobody has booked it; they can't change who booked what.
      allow create: if isOwner() || (canHost()
        && request.resource.data.keys().hasOnly(['start', 'duration', 'location', 'bookedBy', 'createdAt', 'host', 'hostName'])
        && request.resource.data.host == myEmail() && request.resource.data.bookedBy == null
        && request.resource.data.start is int && request.resource.data.duration is int
        && request.resource.data.location is string && request.resource.data.location.size() <= 200
        && request.resource.data.hostName is string && request.resource.data.hostName.size() <= 100);
      allow delete: if isOwner() || (canHost() && resource.data.get('host', '') == myEmail() && resource.data.bookedBy == null);
      allow update: if isOwner() || (
        verified() && onlyChanged(['bookedBy']) && resource.data.start > nowMs() + DAY()
        && (
          (resource.data.bookedBy == null && request.resource.data.bookedBy is string
            && ownsPortal(request.resource.data.bookedBy)
            && portalOf(request.resource.data.bookedBy).data.get('bookingOpen', false) == true
            && getAfter(/databases/$(database)/documents/portal/$(request.resource.data.bookedBy)).data.interview.slotId == slotId)
          ||
          (resource.data.bookedBy != null && request.resource.data.bookedBy == null
            && ownsPortal(resource.data.bookedBy)
            && (getAfter(/databases/$(database)/documents/portal/$(resource.data.bookedBy)).data.interview == null
                || getAfter(/databases/$(database)/documents/portal/$(resource.data.bookedBy)).data.interview.slotId != slotId))
        )
      );
    }

    // Email signature, contact address (admins only)
    // Push notifications: one doc per device that turned them on (id = the device's messaging token). Admins register
    // their own devices; functions/push.js reads them with the Admin SDK. Each person sees and removes only their own.
    match /pushTokens/{token} {
      allow read, delete: if isOwner() || (verified() && resource.data.email == myEmail());
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['email', 'device', 'at'])
        && request.resource.data.email == myEmail()
        && request.resource.data.device is string && request.resource.data.device.size() <= 100
        && request.resource.data.at is int;
    }

    // Squad channels: the owner creates them and picks the members; only members (and the owner) see them or post.
    match /channels/{cid} {
      allow read: if isOwner() || (verified() && myEmail() in resource.data.members);   // works for 'my channels' queries
      allow write: if isOwner()
        && request.resource.data.keys().hasOnly(['name', 'color', 'members', 'names', 'createdAt', 'createdBy', 'updatedAt', 'pin'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.members is list && request.resource.data.members.size() <= 100;
      allow delete: if isOwner();
      match /posts/{pid} {
        allow read: if isOwner() || inChannel(cid);
        allow create: if (isOwner() || inChannel(cid))
          && request.resource.data.keys().hasOnly(['text', 'by', 'name', 'at', 'file'])
          && request.resource.data.by == myEmail()
          && request.resource.data.text is string && request.resource.data.text.size() <= 4000
          && (request.resource.data.text.size() > 0 || request.resource.data.file is map)
          && (!('file' in request.resource.data) || request.resource.data.file.path.matches('chat/' + cid + '/.*'))
          && request.resource.data.name is string && request.resource.data.name.size() <= 100
          && request.resource.data.at is int && request.resource.data.at > nowMs() - 300000 && request.resource.data.at < nowMs() + 300000;
        allow update: if (isOwner() || inChannel(cid)) && onlyChanged(['reactions']) && request.resource.data.reactions is map;
        allow delete: if isOwner() || (inChannel(cid) && resource.data.by == myEmail());
      }
    }
    // Who (besides the owner) is in each applicant's conversation. Owner-managed; members can see the ones they're in.
    match /convos/{appId} {
      allow read: if isOwner() || (verified() && myEmail() in resource.data.members);
      allow write: if isOwner()
        && request.resource.data.keys().hasOnly(['members', 'names', 'updatedAt'])
        && request.resource.data.members is list && request.resource.data.members.size() <= 50;
      allow delete: if isOwner();
    }
    // One-on-one orientation times the owner posts. New members claim or release one for themselves, 24h+ ahead.
    match /orientSlots/{slotId} {
      allow read: if isAdmin() || isInvitedApplicant();
      allow create, delete: if isOwner();
      allow update: if isOwner() || (
        verified() && onlyChanged(['bookedBy']) && resource.data.start > nowMs() + DAY()
        && (
          (resource.data.bookedBy == null && request.resource.data.bookedBy is string
            && ownsPortal(request.resource.data.bookedBy)
            && portalOf(request.resource.data.bookedBy).data.get('orientation', null) != null
            && getAfter(/databases/$(database)/documents/portal/$(request.resource.data.bookedBy)).data.orient.slotId == slotId)
          ||
          (resource.data.bookedBy != null && request.resource.data.bookedBy == null
            && ownsPortal(resource.data.bookedBy)
            && (getAfter(/databases/$(database)/documents/portal/$(resource.data.bookedBy)).data.orient == null
                || getAfter(/databases/$(database)/documents/portal/$(resource.data.bookedBy)).data.orient.slotId != slotId))
        )
      );
    }
    // Trainer sign-offs: the owner picks trainers and the list; a trainer sees only that person's list, nothing else on the file.
    match /signoffs/{appId} {
      allow read: if isAdmin() || (verified() && myEmail() in resource.data.trainers);
      allow create, delete: if isOwner();
      allow update: if isOwner() || (verified() && exists(staffPath()) && myEmail() in resource.data.trainers && onlyChanged(['done', 'updatedAt']));
    }
    // Squad documents: each file lists the roles that can see it; newMembers also shows it in the orientation portal.
    match /library/{docId} {
      allow read: if isOwner() || (verified() && exists(staffPath()) && get(staffPath()).data.role in resource.data.roles)
        || (isInvitedApplicant() && resource.data.newMembers == true);
      allow write: if isOwner();
    }
    // Who's online and typing (squad only). Everyone writes only their own.
    match /presence/{email} {
      allow read: if isStaff();
      allow write: if isStaff() && email == myEmail() && request.resource.data.keys().hasOnly(['at', 'typing', 'typingAt']);
    }
    // Applicants who turned on alerts in their portal. Their own devices only; functions/push.js reads them.
    match /applicantTokens/{token} {
      allow read, delete: if isOwner() || (verified() && resource.data.email == myEmail());
      allow create, update: if ownsPortal(request.resource.data.appId)
        && request.resource.data.keys().hasOnly(['appId', 'email', 'device', 'at'])
        && request.resource.data.email == myEmail()
        && request.resource.data.device is string && request.resource.data.device.size() <= 100
        && request.resource.data.at is int;
    }
    // Each person's "read up to" times for their channels and conversations (unread badges). Your own only.
    match /chatReads/{email} {
      allow read, write: if isStaff() && email == myEmail();
    }

    match /settings/{doc} {
      allow read: if isAdmin();
      allow write: if isOwner();
    }
  }
}
